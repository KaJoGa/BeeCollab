# Copy to .env and adjust. Never commit the real .env.

# Local Postgres from ../docker-compose.yml
DATABASE_URL="postgresql://beecollab:beecollab@localhost:5432/beecollab"
# Used by Prisma migrations (prisma.config.ts prefers it over DATABASE_URL).
# On Neon: DATABASE_URL = pooled host (-pooler), DIRECT_URL = direct host.
DIRECT_URL="postgresql://beecollab:beecollab@localhost:5432/beecollab"

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change_me_dev_only"
JWT_EXPIRES_IN="1d"

PORT=3000
