{
  "name": "beecollab-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Smoke tools and Playwright E2E starter suite for BeeCollab",
  "type": "module",
  "scripts": {
    "wait": "node tools/wait-for-deploy.mjs",
    "seed": "node tools/seed-accounts.mjs",
    "cleanup": "node tools/cleanup.mjs",
    "smoke:api": "node tools/smoke-api.mjs",
    "smoke:ws": "node tools/smoke-ws.mjs",
    "smoke": "node tools/smoke-api.mjs && node tools/smoke-ws.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "socket.io-client": "^4.8.3"
  }
}
